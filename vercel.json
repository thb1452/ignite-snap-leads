{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://ojyxblegxpdgaqiscxpz.supabase.co/functions/v1/dynamic-sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
